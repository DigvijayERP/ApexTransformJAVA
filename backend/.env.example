# Adaptive (Java) — secrets and per-machine values.
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
# NEVER commit real credentials (build brief, Phase 1).
#
# Non-secret environment identity (base URL, app URI, endpoint paths) does NOT
# belong here — it lives in config/environment.json and config/endpoints.json,
# both committed.

# ── QAD connection ────────────────────────────────────────────────────────────
# client_id for the OAuth password grant. Held here rather than in the committed
# config to match AUX's practice (aux_web_version/backend/core/config.py:94).
QAD_CLIENT_ID=
QAD_USERNAME=
QAD_PASSWORD=

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── LLM provider ──────────────────────────────────────────────────────────────
# A NAME, not two booleans: two flags can both be true, which has no correct
# answer. Set ONE of: openai | nvidia
LLM_PROVIDER=nvidia

# NVIDIA NIM. Key from build.nvidia.com (starts nvapi-). NIM speaks the OpenAI
# wire protocol, so only the key and base URL differ - no second client.
NVIDIA_API_KEY=
# Leave blank to use the default (meta/llama-3.3-70b-instruct). Verify the exact
# id in your NVIDIA console before pinning one - catalogues change.
NVIDIA_MODEL=

# ── Local paths (Phase 6 — JEF workspace) ─────────────────────────────────────
# Maven project root for the Java extension build. Left blank until Phase 6.
JEF_WORKSPACE_DIR=
