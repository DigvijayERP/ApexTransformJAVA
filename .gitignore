*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/
*.egg

# Node
node_modules/
npm-debug.log*

# Environment / secrets
# Rule: NEVER commit credentials. backend/.env holds QAD_USERNAME, QAD_PASSWORD
# and OPENAI_API_KEY. backend/.env.example is the committed template with the
# key names and empty values.
.env
*.env.local

# Per-machine / per-environment secret overlay for the endpoint registry.
# config/environments.json IS committed (base URL, app URI, client ID, endpoint
# paths — non-secret). Anything matching *.secret.json is not.
config/*.secret.json
config/*.local.json

# Maven / Java (Phase 6 — JEF workspace)
target/
*.jar
!lib/qad-ext-dependencies.jar.placeholder
.m2/

